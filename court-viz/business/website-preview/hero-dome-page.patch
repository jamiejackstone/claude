+    <img src={src} alt={alt} loading="lazy" className="w-full h-full object-cover aspect-video" />
+    {caption && (
+      <figcaption className="bg-brand-dark text-white text-sm font-bold uppercase tracking-wider px-5 py-3">{caption}</figcaption>
+    )}
+  </figure>
+);
