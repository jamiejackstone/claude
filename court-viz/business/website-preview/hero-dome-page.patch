+            {ROLES.map((role) => (
+              <option key={role} value={role}>{role}</option>
+            ))}
+          </select>
+        </div>
+      </div>
+
+      {form.role === 'Other' && (
+        <div>
+          <label htmlFor="hd-role-other" className={labelClass}>What's your role?</label>
