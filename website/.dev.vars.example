# Copy to .dev.vars for local `wrangler dev` testing.
# In production these are set as Worker secrets (dashboard: Worker → Settings →
# Variables and Secrets, or `npx wrangler secret put <NAME>`).

# Main GHL account — waitlist/taster leads AND franchise enquiries
GHL_API_KEY=

# HR & Recruitment GHL sub-account — coaching applications (set ONE of these)
GHL_HR_WEBHOOK_URL=
GHL_HR_API_KEY=

# OPTIONAL: email notifications via Resend. Leave empty to skip emails —
# everything still lands in GHL, which can send its own notifications.
RESEND_API_KEY=
