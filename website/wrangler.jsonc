/**
 * Hoop Heroes website — Cloudflare Worker + static assets.
 * Deploy with: npm run deploy (runs the Vite build first).
 * Secrets: wrangler secret put RESEND_API_KEY / GHL_API_KEY / GHL_HR_WEBHOOK_URL
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "hoop-heroes-website",
	"main": "worker/index.ts",
	"compatibility_date": "2025-03-10",
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS",
		"not_found_handling": "single-page-application",
		// Worker sees every request so it can 301 legacy URLs and 404 unknown pages
		"run_worker_first": true,
	},
	"observability": {
		"enabled": true,
	},
}
